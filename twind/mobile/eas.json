{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.twind.app",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.twind.app",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
