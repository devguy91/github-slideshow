# Copy to .env for local dev. All keys are prefixed TWIND_.
TWIND_ENV=dev
TWIND_DATABASE_URL=postgresql+asyncpg://twind:twind@localhost:5432/twind   # or sqlite+aiosqlite:///./twind.db
TWIND_REDIS_URL=redis://localhost:6379/0

# Auth — Supabase: project JWT secret (HS256). Clerk: set TWIND_JWT_JWKS_URL instead.
TWIND_JWT_SECRET=replace-with-your-supabase-jwt-secret
TWIND_JWT_AUDIENCE=authenticated
# TWIND_JWT_JWKS_URL=https://<clerk-frontend-api>/.well-known/jwks.json
TWIND_DEV_TOKEN_ENDPOINT=true   # must be false in prod (also disabled automatically when TWIND_ENV=prod)

# Payments — fake in dev, stripe in prod
TWIND_PAYMENTS_PROVIDER=fake
# TWIND_STRIPE_SECRET_KEY=sk_live_...
# TWIND_STRIPE_PUBLISHABLE_KEY=pk_live_...
# TWIND_STRIPE_WEBHOOK_SECRET=whsec_...

# Business rules
TWIND_SELLER_FEE_BPS=0
TWIND_PROTECTION_FEE_FIXED_PENCE=99
TWIND_PROTECTION_FEE_BPS=300
TWIND_SHIPPING_FLAT_PENCE=399
TWIND_AUTO_RELEASE_DAYS=3
TWIND_AUTO_RELEASE_DAYS_HIGH_ACCURACY=1

# Images (Cloudflare R2, S3-compatible). Leave R2_BUCKET unset for local dev URLs.
TWIND_R2_PUBLIC_BASE_URL=https://img.twind.app
# TWIND_R2_BUCKET=twind-images
# TWIND_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TWIND_R2_ACCESS_KEY_ID=
# TWIND_R2_SECRET_ACCESS_KEY=

# Observability
# TWIND_SENTRY_DSN=
# TWIND_POSTHOG_API_KEY=
